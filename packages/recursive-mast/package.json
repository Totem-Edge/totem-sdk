{
  "name": "@totemsdk/recursive-mast",
  "version": "0.2.7",
  "description": "Recursive MAST + PREVSTATE library — composable policy trees, proof chains, state transitions, and delegation workflows for Minima KISSVM",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./templates/*": {
      "import": {
        "types": "./dist/templates/*.d.ts",
        "default": "./dist/templates/*.js"
      },
      "require": {
        "types": "./dist/cjs/templates/*.d.ts",
        "default": "./dist/cjs/templates/*.js"
      }
    },
    "./kissvm": {
      "import": {
        "types": "./dist/kissvm/index.d.ts",
        "default": "./dist/kissvm/index.js"
      },
      "require": {
        "types": "./dist/cjs/kissvm/index.d.ts",
        "default": "./dist/cjs/kissvm/index.js"
      }
    },
    "./transaction": {
      "import": {
        "types": "./dist/transaction/index.d.ts",
        "default": "./dist/transaction/index.js"
      },
      "require": {
        "types": "./dist/cjs/transaction/index.d.ts",
        "default": "./dist/cjs/transaction/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "build:wasm": "cd rust && wasm-pack build --target bundler --out-dir pkg && wasm-pack build --target nodejs --out-dir pkg-node",
    "prepare": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "clean": "rm -rf dist rust/pkg rust/pkg-node rust/target",
    "test": "jest"
  },
  "files": [
    "dist",
    "rust/pkg/",
    "rust/pkg-node/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "totem",
    "totemsdk",
    "recursive-mast",
    "kissvm",
    "governance",
    "policy",
    "wots"
  ],
  "dependencies": {
    "@totemsdk/core": "workspace:^",
    "@totemsdk/kissvm": "workspace:^"
  },
  "peerDependencies": {
    "@totemsdk/tx-builder": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@totemsdk/tx-builder": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Totem SDK",
  "homepage": "https://docs.totem.ing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totem-Edge/totem-sdk.git",
    "directory": "packages/recursive-mast"
  },
  "bugs": {
    "url": "https://github.com/Totem-Edge/totem-sdk/issues"
  },
  "type": "module",
  "typesVersions": {
    "*": {
      "templates/*": [
        "./dist/cjs/templates/*.d.ts"
      ],
      "kissvm": [
        "./dist/cjs/kissvm/index.d.ts"
      ],
      "transaction": [
        "./dist/cjs/transaction/index.d.ts"
      ]
    }
  }
}
