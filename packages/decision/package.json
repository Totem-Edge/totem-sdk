{
  "name": "@totemsdk/decision",
  "version": "0.1.0",
  "description": "Provider-neutral decision runtime — typed, constrained, provenance-bound proposals over dynamic candidate spaces (AI proposes, Totem authorizes)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "require": "./dist/types.js",
      "import": "./dist/types.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "require": "./dist/constants.js",
      "import": "./dist/constants.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "require": "./dist/errors.js",
      "import": "./dist/errors.js"
    },
    "./laya": {
      "types": "./dist/adapters/laya.d.ts",
      "require": "./dist/adapters/laya.js",
      "import": "./dist/adapters/laya.js"
    },
    "./jev": {
      "types": "./dist/adapters/jev.d.ts",
      "require": "./dist/adapters/jev.js",
      "import": "./dist/adapters/jev.js"
    },
    "./intelligence": {
      "types": "./dist/adapters/intelligence.d.ts",
      "require": "./dist/adapters/intelligence.js",
      "import": "./dist/adapters/intelligence.js"
    },
    "./testing": {
      "types": "./dist/testing/mock-provider.d.ts",
      "require": "./dist/testing/mock-provider.js",
      "import": "./dist/testing/mock-provider.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "clean": "rm -rf dist",
    "test": "jest"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@totemsdk/core": "workspace:^",
    "@totemsdk/intelligence": "workspace:^"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Totem SDK",
  "homepage": "https://docs.totem.ing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totem-Edge/totem-sdk.git",
    "directory": "packages/decision"
  },
  "keywords": [
    "totem",
    "totemsdk",
    "decision",
    "runtime",
    "edge-ai",
    "proposal",
    "provider-neutral",
    "bounded-choice",
    "governance"
  ],
  "bugs": {
    "url": "https://github.com/Totem-Edge/totem-sdk/issues"
  }
}
