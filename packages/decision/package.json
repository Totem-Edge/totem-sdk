{
  "name": "@totemsdk/decision",
  "version": "0.2.0",
  "description": "Provider-neutral decision runtime — typed, constrained, provenance-bound proposals over dynamic candidate spaces (AI proposes, Totem authorizes)",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "require": {
        "types": "./dist/cjs/types.d.ts",
        "default": "./dist/cjs/types.js"
      }
    },
    "./constants": {
      "import": {
        "types": "./dist/constants.d.ts",
        "default": "./dist/constants.js"
      },
      "require": {
        "types": "./dist/cjs/constants.d.ts",
        "default": "./dist/cjs/constants.js"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/errors.d.ts",
        "default": "./dist/errors.js"
      },
      "require": {
        "types": "./dist/cjs/errors.d.ts",
        "default": "./dist/cjs/errors.js"
      }
    },
    "./laya": {
      "import": {
        "types": "./dist/adapters/laya.d.ts",
        "default": "./dist/adapters/laya.js"
      },
      "require": {
        "types": "./dist/cjs/adapters/laya.d.ts",
        "default": "./dist/cjs/adapters/laya.js"
      }
    },
    "./jev": {
      "import": {
        "types": "./dist/adapters/jev.d.ts",
        "default": "./dist/adapters/jev.js"
      },
      "require": {
        "types": "./dist/cjs/adapters/jev.d.ts",
        "default": "./dist/cjs/adapters/jev.js"
      }
    },
    "./intelligence": {
      "import": {
        "types": "./dist/adapters/intelligence.d.ts",
        "default": "./dist/adapters/intelligence.js"
      },
      "require": {
        "types": "./dist/cjs/adapters/intelligence.d.ts",
        "default": "./dist/cjs/adapters/intelligence.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/mock-provider.d.ts",
        "default": "./dist/testing/mock-provider.js"
      },
      "require": {
        "types": "./dist/cjs/testing/mock-provider.d.ts",
        "default": "./dist/cjs/testing/mock-provider.js"
      }
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "prepare": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "clean": "rm -rf dist",
    "test": "jest"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@totemsdk/core": "workspace:^",
    "@totemsdk/intelligence": "workspace:^"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Totem SDK",
  "homepage": "https://docs.totem.ing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totem-Edge/totem-sdk.git",
    "directory": "packages/decision"
  },
  "keywords": [
    "totem",
    "totemsdk",
    "decision",
    "runtime",
    "edge-ai",
    "proposal",
    "provider-neutral",
    "bounded-choice",
    "governance"
  ],
  "bugs": {
    "url": "https://github.com/Totem-Edge/totem-sdk/issues"
  },
  "type": "module",
  "typesVersions": {
    "*": {
      "types": [
        "./dist/cjs/types.d.ts"
      ],
      "constants": [
        "./dist/cjs/constants.d.ts"
      ],
      "errors": [
        "./dist/cjs/errors.d.ts"
      ],
      "laya": [
        "./dist/cjs/adapters/laya.d.ts"
      ],
      "jev": [
        "./dist/cjs/adapters/jev.d.ts"
      ],
      "intelligence": [
        "./dist/cjs/adapters/intelligence.d.ts"
      ],
      "testing": [
        "./dist/cjs/testing/mock-provider.d.ts"
      ]
    }
  }
}
