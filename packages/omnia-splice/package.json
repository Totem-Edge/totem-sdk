{
  "name": "@totemsdk/omnia-splice",
  "version": "0.2.0",
  "description": "Channel splicing for @totemsdk/omnia — resize Minima eltoo channels without a close+reopen cycle",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:wasm && tsc && node ../../scripts/clean-wasm-output-ignores.mjs",
    "prepare": "npm run build:wasm && tsc && node ../../scripts/clean-wasm-output-ignores.mjs",
    "clean": "rm -rf dist rust/pkg rust/pkg-node rust/target",
    "test": "jest",
    "build:wasm": "cd rust && wasm-pack build --target bundler --out-dir pkg && wasm-pack build --target nodejs --out-dir pkg-node"
  },
  "files": [
    "dist",
    "rust/pkg/",
    "rust/pkg-node/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@totemsdk/omnia": "workspace:^",
    "@totemsdk/core": "workspace:^",
    "@totemsdk/tx-builder": "workspace:^",
    "@totemsdk/txpow": "workspace:^",
    "@totemsdk/wots-lease": "workspace:^"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Totem SDK",
  "homepage": "https://docs.totem.ing",
  "bugs": {
    "url": "https://github.com/Totem-Edge/totem-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totem-Edge/totem-sdk.git",
    "directory": "packages/omnia-splice"
  },
  "keywords": [
    "totem",
    "totemsdk",
    "minima",
    "blockchain",
    "quantum-resistant",
    "wots",
    "utxo",
    "omnia",
    "payment-channel",
    "eltoo",
    "layer2",
    "splice",
    "channel-resize",
    "htlc"
  ]
}
