{
  "name": "@totemsdk/omnia-pool",
  "version": "0.5.4",
  "description": "Generic Omnia liquidity pool orchestration primitive for Totem SDK",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "prepare": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "clean": "rm -rf dist",
    "test": "jest --config ../../tests/jest/omnia-pool.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@totemsdk/agent-policy": "workspace:^",
    "@totemsdk/chain-provider": "workspace:^",
    "@totemsdk/liquidity-bond": "workspace:^",
    "@totemsdk/storage": "workspace:^",
    "@totemsdk/tx-builder": "workspace:^",
    "@totemsdk/wots-lease": "workspace:^",
    "@totemsdk/core": "workspace:^",
    "@totemsdk/omnia": "workspace:^",
    "@totemsdk/omnia-factory": "workspace:^",
    "@totemsdk/omnia-router": "workspace:^",
    "@totemsdk/omnia-splice": "workspace:^",
    "@totemsdk/omnia-vtxo": "workspace:^"
  },
  "devDependencies": {
    "@totemsdk/authority": "workspace:^",
    "@totemsdk/identity": "workspace:^",
    "@totemsdk/proof": "workspace:^",
    "@types/node": "^20.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "author": "Totem SDK",
  "homepage": "https://docs.totem.ing",
  "bugs": {
    "url": "https://github.com/Totem-Edge/totem-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totem-Edge/totem-sdk.git",
    "directory": "packages/omnia-pool"
  },
  "keywords": [
    "totem",
    "totemsdk",
    "omnia",
    "liquidity",
    "pool",
    "LP",
    "minima"
  ],
  "type": "module"
}
