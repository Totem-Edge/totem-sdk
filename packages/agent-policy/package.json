{
  "name": "@totemsdk/agent-policy",
  "version": "0.4.0",
  "description": "Agent-policy interface contracts \u2014 language-agnostic Protobuf schema for AI agent \u2194 wallet communication",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "npm run generate:proto && tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "prepare": "npm run generate:proto && tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "generate:proto": "node scripts/generate-proto.mjs",
    "clean": "rm -rf dist src/generated",
    "test": "jest --config ../../tests/jest/agent-policy.cjs"
  },
  "files": [
    "dist",
    "src/generated",
    "proto",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@protobuf-ts/runtime": "^2.11.1",
    "@totemsdk/core": "workspace:^",
    "@totemsdk/authority": "workspace:^",
    "@totemsdk/intelligence": "workspace:^",
    "@totemsdk/proof": "workspace:^",
    "@totemsdk/storage": "workspace:^",
    "@totemsdk/replication": "workspace:^"
  },
  "devDependencies": {
    "@protobuf-ts/plugin": "^2.9.4",
    "@totemsdk/identity": "workspace:^",
    "better-sqlite3": "^12.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "jest": "^30.4.2",
    "ts-jest": "^29.0.0",
    "typescript": "~5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "author": "Totem SDK",
  "homepage": "https://docs.totem.ing",
  "bugs": {
    "url": "https://github.com/Totem-Edge/totem-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totem-Edge/totem-sdk.git",
    "directory": "packages/agent-policy"
  },
  "keywords": [
    "totem",
    "totemsdk",
    "minima",
    "blockchain",
    "quantum-resistant",
    "wots",
    "utxo",
    "ai",
    "agents",
    "policy",
    "payment-intent",
    "automation",
    "types"
  ],
  "type": "module"
}
