{
  "name": "@totemsdk/pear",
  "version": "0.2.1",
  "description": "Bare/Pear runtime integration harness for @totemsdk — storage, networking, lifecycle, and Hyperdrive adapters for Pear apps",
  "type": "module",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "typesVersions": {
    "*": {
      "storage": [
        "dist/cjs/storage/index.d.ts"
      ],
      "network": [
        "dist/cjs/network/index.d.ts"
      ],
      "lifecycle": [
        "dist/cjs/lifecycle.d.ts"
      ],
      "hyperdrive": [
        "dist/cjs/hyperdrive.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./storage": {
      "import": {
        "types": "./dist/storage/index.d.ts",
        "default": "./dist/storage/index.js"
      },
      "require": {
        "types": "./dist/cjs/storage/index.d.ts",
        "default": "./dist/cjs/storage/index.js"
      }
    },
    "./network": {
      "import": {
        "types": "./dist/network/index.d.ts",
        "default": "./dist/network/index.js"
      },
      "require": {
        "types": "./dist/cjs/network/index.d.ts",
        "default": "./dist/cjs/network/index.js"
      }
    },
    "./lifecycle": {
      "import": {
        "types": "./dist/lifecycle.d.ts",
        "default": "./dist/lifecycle.js"
      },
      "require": {
        "types": "./dist/cjs/lifecycle.d.ts",
        "default": "./dist/cjs/lifecycle.js"
      }
    },
    "./hyperdrive": {
      "import": {
        "types": "./dist/hyperdrive.d.ts",
        "default": "./dist/hyperdrive.js"
      },
      "require": {
        "types": "./dist/cjs/hyperdrive.d.ts",
        "default": "./dist/cjs/hyperdrive.js"
      }
    }
  },
  "dependencies": {
    "@totemsdk/storage": "workspace:^",
    "@totemsdk/stream-transport": "workspace:^",
    "@noble/hashes": "^2.2.0"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "prepare": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:bare": "node src/__tests__/bare/run-bare.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "hyperswarm": ">=4.0.0",
    "hyperbee": ">=2.0.0",
    "hypercore": ">=10.0.0",
    "hyperdrive": ">=2.0.0",
    "corestore": ">=6.0.0",
    "bare-http1": ">=3.0.0",
    "bare-fs": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "hyperswarm": {
      "optional": true
    },
    "hyperbee": {
      "optional": true
    },
    "hypercore": {
      "optional": true
    },
    "hyperdrive": {
      "optional": true
    },
    "corestore": {
      "optional": true
    },
    "bare-http1": {
      "optional": true
    },
    "bare-fs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Totem SDK",
  "homepage": "https://docs.totem.ing",
  "bugs": {
    "url": "https://github.com/Totem-Edge/totem-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totem-Edge/totem-sdk.git",
    "directory": "packages/pear"
  },
  "keywords": [
    "totem",
    "totemsdk",
    "minima",
    "blockchain",
    "quantum-resistant",
    "wots",
    "utxo",
    "pear",
    "bare"
  ]
}
