{
  "name": "@totemsdk/lookup-node",
  "version": "0.4.0",
  "description": "Always-on personal lookup node — accepts Hyperswarm connections, answers chain queries, pushes COIN_UPDATE to watchlist subscribers, relays TxPoW, and coordinates WOTS leases",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && rm -rf dist/__tests__",
    "build:go": "cd go && go build -o ../bin/lookup-node .",
    "prepare": "tsc && rm -rf dist/__tests__",
    "prepack": "rm -rf dist/__tests__",
    "clean": "rm -rf dist bin",
    "test": "jest --config ../../tests/jest/lookup-node.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@totemsdk/core": "workspace:^",
    "@totemsdk/lookup-protocol": "workspace:^",
    "@totemsdk/manifest": "workspace:^",
    "@totemsdk/chain-provider": "workspace:^",
    "@totemsdk/minima-rpc": "workspace:^",
    "@totemsdk/wots-lease": "workspace:^",
    "@totemsdk/txpow": "workspace:^",
    "better-sqlite3": "^12.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "author": "Totem SDK",
  "homepage": "https://docs.totem.ing",
  "bugs": {
    "url": "https://github.com/Totem-Edge/totem-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totem-Edge/totem-sdk.git",
    "directory": "packages/lookup-node"
  },
  "keywords": [
    "totem",
    "totemsdk",
    "minima",
    "blockchain",
    "quantum-resistant",
    "wots",
    "utxo",
    "hyperswarm",
    "p2p"
  ]
}
