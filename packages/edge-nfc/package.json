{
  "name": "@totemsdk/edge-nfc",
  "version": "0.1.1",
  "description": "Edge runtime adapter for NFC — reader polling, NDEF, secure-element APDU, P2P, HCE",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "prepare": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "clean": "rm -rf dist",
    "test": "jest --config ../../tests/jest/edge-nfc.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@totemsdk/edge": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "author": "Totem SDK",
  "homepage": "https://docs.totem.ing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totem-Edge/totem-sdk.git",
    "directory": "packages/edge-nfc"
  },
  "keywords": [
    "totem",
    "totemsdk",
    "minima",
    "edge",
    "nfc",
    "ndef",
    "apdu",
    "transport"
  ],
  "bugs": {
    "url": "https://github.com/Totem-Edge/totem-sdk/issues"
  },
  "type": "module"
}
