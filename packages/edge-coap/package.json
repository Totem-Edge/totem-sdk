{
  "name": "@totemsdk/edge-coap",
  "version": "0.3.0",
  "description": "Edge runtime adapter for CoAP \u2014 constrained devices, RFC 7252, UDP transport",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "prepare": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "clean": "rm -rf dist bin",
    "test": "jest --config ../../tests/jest/edge-coap.cjs",
    "build:go": "cd go && go build -o ../bin/edge-coap .",
    "test:go": "cd go && go test -race ./... && go vet ./...",
    "test:conformance": "node --test ../../tests/qualification/edge-coap/coap-conformance.test.mjs",
    "test:integration": "node --test ../../tests/qualification/edge-coap/integration.test.mjs",
    "test:recovery": "node --test ../../tests/qualification/edge-coap/recovery.test.mjs",
    "test:consumer": "node --test ../../tests/qualification/edge-coap/packed-consumer.test.mjs",
    "test:oscore": "node --test ../../tests/qualification/edge-coap/oscore.test.mjs"
  },
  "files": [
    "dist",
    "sidecar.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@totemsdk/edge": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "author": "Totem SDK",
  "homepage": "https://docs.totem.ing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totem-Edge/totem-sdk.git",
    "directory": "packages/edge-coap"
  },
  "keywords": [
    "totem",
    "totemsdk",
    "minima",
    "blockchain",
    "edge",
    "coap",
    "transport"
  ],
  "bugs": {
    "url": "https://github.com/Totem-Edge/totem-sdk/issues"
  },
  "type": "module"
}
