{
  "name": "@totemsdk/omnia-host",
  "version": "0.13.2",
  "description": "Durable Omnia node daemon for channel lifecycle, routing, and control APIs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "omnia-host": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const f='dist/cli.js';const c='#!/usr/bin/env node\\n'+fs.readFileSync(f,'utf8');fs.writeFileSync(f,c);fs.chmodSync(f,0o755)\"",
    "prepare": "tsc && node -e \"const fs=require('fs');const f='dist/cli.js';const c='#!/usr/bin/env node\\n'+fs.readFileSync(f,'utf8');fs.writeFileSync(f,c);fs.chmodSync(f,0o755)\"",
    "clean": "rm -rf dist",
    "test": "jest",
    "start": "node dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@totemsdk/chain-provider": "workspace:^",
    "@totemsdk/core": "workspace:^",
    "@totemsdk/identity": "workspace:^",
    "@totemsdk/liquidity-bond": "workspace:^",
    "@totemsdk/manifest": "workspace:^",
    "@totemsdk/minima-rpc": "workspace:^",
    "@totemsdk/omnia": "workspace:^",
    "@totemsdk/omnia-factory": "workspace:^",
    "@totemsdk/omnia-pool": "workspace:^",
    "@totemsdk/omnia-router": "workspace:^",
    "@totemsdk/omnia-splice": "workspace:^",
    "@totemsdk/omnia-vtxo": "workspace:^",
    "@totemsdk/p2p-hub": "workspace:^",
    "@totemsdk/storage": "workspace:^",
    "@totemsdk/tx-builder": "workspace:^",
    "@totemsdk/wots-lease": "workspace:^",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.5.0",
    "@totemsdk/txpow": "workspace:^",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "author": "Totem SDK",
  "homepage": "https://docs.totem.ing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totem-Edge/totem-sdk.git",
    "directory": "packages/omnia-host"
  },
  "bugs": {
    "url": "https://github.com/Totem-Edge/totem-sdk/issues"
  },
  "keywords": [
    "totem",
    "totemsdk",
    "omnia",
    "payment-channel",
    "daemon",
    "node"
  ]
}
