{
  "name": "@totemsdk/edge",
  "version": "1.5.1",
  "description": "Unified developer-facing runtime for Totem Edge — composes identity, manifest, wallet/payment/proof/lookup/policy capabilities via injected ports",
  "type": "module",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "prepare": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "clean": "rm -rf dist",
    "test": "jest --config ../../tests/jest/edge.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@totemsdk/core": "workspace:^",
    "@totemsdk/manifest": "workspace:^",
    "@totemsdk/identity": "workspace:^",
    "@totemsdk/agent-policy": "workspace:^",
    "@totemsdk/storage": "workspace:^",
    "@totemsdk/txpow": "workspace:^",
    "@totemsdk/intelligence": "workspace:^",
    "@totemsdk/decision": "workspace:^",
    "@totemsdk/replication": "workspace:^"
  },
  "peerDependencies": {
    "@totemsdk/connect": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@totemsdk/connect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@totemsdk/authority": "workspace:^",
    "@totemsdk/connect": "workspace:^",
    "@totemsdk/proof": "workspace:^",
    "@types/node": "^20.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "author": "Totem SDK",
  "homepage": "https://docs.totem.ing",
  "bugs": {
    "url": "https://github.com/Totem-Edge/totem-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totem-Edge/totem-sdk.git",
    "directory": "packages/edge"
  },
  "keywords": [
    "totem",
    "totemsdk",
    "minima",
    "blockchain",
    "quantum-resistant",
    "wots",
    "utxo"
  ]
}
