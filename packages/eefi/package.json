{
  "name": "@totemsdk/eefi",
  "version": "0.1.1",
  "description": "Eefi generic contracts \u2014 neutral capital, market, risk and exercise agreement schemas with canonical digests",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "prepare": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "clean": "rm -rf dist",
    "test": "jest --config ../../tests/jest/eefi.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@totemsdk/core": "workspace:^"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "jest": "^30.4.2",
    "ts-jest": "^29.0.0",
    "typescript": "~5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "author": "Totem SDK",
  "homepage": "https://docs.totem.ing",
  "bugs": {
    "url": "https://github.com/Totem-Edge/totem-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totem-Edge/totem-sdk.git",
    "directory": "packages/eefi"
  },
  "keywords": [
    "totem",
    "totemsdk",
    "eefi",
    "programmable-capital",
    "contracts",
    "capital",
    "market",
    "risk",
    "types"
  ],
  "type": "module"
}
