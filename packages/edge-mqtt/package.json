{
  "name": "@totemsdk/edge-mqtt",
  "version": "0.3.1",
  "description": "MQTT adapter for Totem Edge \u2014 Rust/WASM-backed canonicalization, topic matching, and MachinePay arithmetic",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "typesVersions": {
    "*": {
      "sqlite-replay-store": [
        "./dist/cjs/sqlite-replay-store.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./sqlite-replay-store": {
      "import": {
        "types": "./dist/sqlite-replay-store.d.ts",
        "default": "./dist/sqlite-replay-store.js"
      },
      "require": {
        "types": "./dist/cjs/sqlite-replay-store.d.ts",
        "default": "./dist/cjs/sqlite-replay-store.js"
      }
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node scripts/finalize-build.cjs",
    "build:wasm": "cd rust && wasm-pack build --target bundler --out-dir pkg && wasm-pack build --target nodejs --out-dir pkg-node && node ../scripts/prepare-wasm-assets.cjs",
    "prepare": "tsc && tsc -p tsconfig.cjs.json && node scripts/finalize-build.cjs",
    "prepack": "node scripts/prepare-wasm-assets.cjs",
    "clean": "rm -rf dist rust/pkg rust/pkg-node rust/target",
    "test": "jest",
    "test:recovery": "node --test test/replay-recovery.test.mjs",
    "test:consumer": "node --test test/packed-consumer.test.mjs",
    "test:conformance": "node --test test/broker-matrix.test.mjs && node --test test/signing-conformance.test.mjs",
    "test:signing": "node --test test/signing-conformance.test.mjs",
    "test:broker-matrix": "node --test test/broker-matrix.test.mjs",
    "test:integration": "node --test test/broker-conformance.test.mjs"
  },
  "files": [
    "dist",
    "rust/pkg/",
    "rust/pkg-node/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@totemsdk/agent-policy": "workspace:^",
    "@totemsdk/core": "workspace:^",
    "@totemsdk/edge": "workspace:^",
    "@totemsdk/identity": "workspace:^",
    "@totemsdk/manifest": "workspace:^",
    "@totemsdk/proof": "workspace:^",
    "@totemsdk/pubsub-transport": "workspace:^",
    "@totemsdk/storage": "workspace:^"
  },
  "devDependencies": {
    "@totemsdk/wots-lease": "workspace:^",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "aedes": "1.2.0",
    "jest": "^30.4.2",
    "mqtt": "5.16.1",
    "ts-jest": "^29.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "author": "Totem SDK",
  "homepage": "https://docs.totem.ing",
  "bugs": {
    "url": "https://github.com/Totem-Edge/totem-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totem-Edge/totem-sdk.git",
    "directory": "packages/edge-mqtt"
  },
  "keywords": [
    "totem",
    "totemsdk",
    "minima",
    "blockchain",
    "quantum-resistant",
    "wots",
    "utxo",
    "mqtt",
    "iot",
    "edge",
    "sensor",
    "gateway",
    "machinepay",
    "pear",
    "hyperswarm",
    "bare"
  ],
  "type": "module"
}
