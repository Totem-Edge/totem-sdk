{
  "name": "@totemsdk/core-wasm",
  "version": "1.0.1",
  "description": "WOTS (Winternitz) cryptographic engine compiled to WASM — Rust core for @totemsdk/core",
  "main": "pkg-node/totemsdk_core_wasm.js",
  "types": "pkg/totemsdk_core_wasm.d.ts",
  "exports": {
    ".": {
      "types": "./pkg/totemsdk_core_wasm.d.ts",
      "require": "./pkg-node/totemsdk_core_wasm.js",
      "import": "./pkg/totemsdk_core_wasm.js",
      "default": "./pkg-node/totemsdk_core_wasm.js"
    },
    "./web": {
      "types": "./pkg-web/totemsdk_core_wasm.d.ts",
      "import": "./pkg-web/totemsdk_core_wasm.js",
      "default": "./pkg-web/totemsdk_core_wasm.js"
    }
  },
  "files": [
    "pkg/",
    "pkg-node/",
    "pkg-web/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:bundler && npm run build:node && npm run build:web",
    "build:bundler": "wasm-pack build --target bundler --out-dir pkg && node scripts/prepare-publish-assets.mjs",
    "build:node": "wasm-pack build --target nodejs --out-dir pkg-node && node scripts/prepare-publish-assets.mjs",
    "build:web": "wasm-pack build --target web --out-dir pkg-web && node scripts/prepare-publish-assets.mjs",
    "test": "wasm-pack test --node",
    "test:web": "node tests/web-init.test.mjs && node tests/web-worker.mjs",
    "test:web:bun": "bun tests/web-init.test.mjs && bun tests/web-worker.mjs",
    "artifacts:write": "node scripts/write-artifacts.mjs",
    "artifacts:verify": "node scripts/verify-artifacts.mjs",
    "sbom:write": "node scripts/write-sbom.mjs",
    "budgets:check": "node scripts/check-budgets.mjs",
    "clean": "rm -rf pkg pkg-node pkg-web target"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totem-Edge/totem-sdk.git",
    "directory": "packages/core-wasm"
  },
  "bugs": {
    "url": "https://github.com/Totem-Edge/totem-sdk/issues"
  },
  "homepage": "https://docs.totem.ing",
  "author": "Totem SDK",
  "license": "MIT",
  "keywords": [
    "totem",
    "totemsdk",
    "minima",
    "blockchain",
    "quantum-resistant",
    "wots",
    "utxo",
    "cryptography",
    "wasm",
    "rust",
    "webassembly"
  ],
  "publishConfig": {
    "access": "public"
  }
}
