{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "baseUrl": ".",
    "paths": {
      "@totemsdk/core": ["../core/src/index"],
      "@totemsdk/realtime": ["../realtime/src/index"],
      "@totemsdk/identity": ["../identity/src/index"],
      "@totemsdk/edge": ["../edge/src/index"],
      "@totemsdk/manifest": ["../manifest/src/index"],
      "@totemsdk/agent-policy": ["../agent-policy/src/index"],
      "@totemsdk/connect": ["../connect/src/index"],
      "@totemsdk/liquidity-bond": ["../liquidity-bond/src/index"],
      "@totemsdk/omnia-pool": ["../omnia-pool/src/index"],
      "@totemsdk/omnia-vtxo": ["../omnia-vtxo/src/index"],
      "@totemsdk/omnia": ["../omnia/src/index"],
      "@totemsdk/omnia-router": ["../omnia-router/src/index"],
      "@totemsdk/chain-provider": ["../chain-provider/src/index"],
      "@totemsdk/tx-builder": ["../tx-builder/src/index"],
      "@totemsdk/wots-lease": ["../wots-lease/src/index"]
    }
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
