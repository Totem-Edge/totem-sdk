{
  "name": "@totemsdk/edge-mavlink",
  "version": "0.2.0",
  "description": "Edge runtime adapter for MAVLink — drone telemetry, heartbeat, commands, wire framing",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./governed": {
      "import": {
        "types": "./dist/governed/index.d.ts",
        "default": "./dist/governed/index.js"
      },
      "require": {
        "types": "./dist/cjs/governed/index.d.ts",
        "default": "./dist/cjs/governed/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "prepare": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "clean": "rm -rf dist",
    "test": "jest --config ../../tests/jest/edge-mavlink.cjs",
    "test:integration": "node --test ../../tests/qualification/edge-mavlink/integration.test.mjs ../../tests/qualification/edge-mavlink/governed.integration.test.mjs",
    "test:governed": "jest --config ../../tests/jest/edge-mavlink.cjs governed"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@totemsdk/edge": "workspace:^",
    "@totemsdk/act-core": "workspace:^",
    "@totemsdk/agent-policy": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "author": "Totem SDK",
  "homepage": "https://docs.totem.ing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totem-Edge/totem-sdk.git",
    "directory": "packages/edge-mavlink"
  },
  "keywords": [
    "totem",
    "totemsdk",
    "minima",
    "blockchain",
    "edge",
    "mavlink",
    "drone",
    "uav",
    "telemetry"
  ],
  "bugs": {
    "url": "https://github.com/Totem-Edge/totem-sdk/issues"
  },
  "type": "module"
}
