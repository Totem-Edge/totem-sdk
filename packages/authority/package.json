{
  "name": "@totemsdk/authority",
  "version": "1.0.1",
  "description": "Deterministic authority engine for Totem Edge — mandate verification, scope matching, usage tracking, and authority evaluation",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "build:wasm": "cd rust && wasm-pack build --target bundler --out-dir pkg && wasm-pack build --target nodejs --out-dir pkg-node",
    "prepare": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "clean": "rm -rf dist rust/pkg rust/pkg-node rust/target",
    "test": "jest",
    "test:rust": "cd rust && cargo test"
  },
  "files": [
    "dist",
    "rust/pkg/",
    "rust/pkg-node/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@totemsdk/proof": "workspace:^",
    "@totemsdk/identity": "workspace:^"
  },
  "devDependencies": {
    "@totemsdk/core": "workspace:^",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "totem",
    "totemsdk",
    "minima",
    "blockchain",
    "quantum-resistant",
    "wots",
    "authority",
    "mandate",
    "governance",
    "edge-computing",
    "cryptography"
  ],
  "bugs": {
    "url": "https://github.com/Totem-Edge/totem-sdk/issues"
  },
  "license": "MIT",
  "author": "Totem SDK",
  "homepage": "https://docs.totem.ing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totem-Edge/totem-sdk.git",
    "directory": "packages/authority"
  },
  "type": "module"
}
