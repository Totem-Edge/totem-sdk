{
  "name": "@totemsdk/edge-adapters",
  "version": "0.2.1",
  "description": "Reference adapters bridging Totem SDK packages to @totemsdk/edge port interfaces",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "prepare": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "clean": "rm -rf dist",
    "test": "jest"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@totemsdk/storage": "workspace:^"
  },
  "peerDependencies": {
    "@totemsdk/agent-policy": "workspace:^",
    "@totemsdk/chain-provider": "workspace:^",
    "@totemsdk/identity": "workspace:^",
    "@totemsdk/lookup-client": "workspace:^",
    "@totemsdk/location-proof": "workspace:^",
    "@totemsdk/manifest": "workspace:^",
    "@totemsdk/omnia-router": "workspace:^",
    "@totemsdk/proof": "workspace:^",
    "@totemsdk/pubsub-transport": "workspace:^",
    "@totemsdk/root-identity": "workspace:^",
    "@totemsdk/stream-transport": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@totemsdk/agent-policy": {
      "optional": true
    },
    "@totemsdk/chain-provider": {
      "optional": true
    },
    "@totemsdk/identity": {
      "optional": false
    },
    "@totemsdk/manifest": {
      "optional": false
    },
    "@totemsdk/omnia-router": {
      "optional": false
    },
    "@totemsdk/proof": {
      "optional": false
    },
    "@totemsdk/lookup-client": {
      "optional": true
    },
    "@totemsdk/location-proof": {
      "optional": false
    },
    "@totemsdk/pubsub-transport": {
      "optional": true
    },
    "@totemsdk/root-identity": {
      "optional": true
    },
    "@totemsdk/stream-transport": {
      "optional": true
    }
  },
  "devDependencies": {
    "@totemsdk/agent-policy": "workspace:^",
    "@totemsdk/chain-provider": "workspace:^",
    "@totemsdk/core": "workspace:^",
    "@totemsdk/edge": "workspace:^",
    "@totemsdk/identity": "workspace:^",
    "@totemsdk/lookup-client": "workspace:^",
    "@totemsdk/location-proof": "workspace:^",
    "@totemsdk/manifest": "workspace:^",
    "@totemsdk/omnia-router": "workspace:^",
    "@totemsdk/proof": "workspace:^",
    "@totemsdk/pubsub-transport": "workspace:^",
    "@totemsdk/root-identity": "workspace:^",
    "@totemsdk/stream-transport": "workspace:^",
    "@totemsdk/txpow": "workspace:^",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
