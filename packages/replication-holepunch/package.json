{
  "name": "@totemsdk/replication-holepunch",
  "version": "0.2.0",
  "description": "Holepunch adapters for @totemsdk/replication — Hypercore logs, Hyperbee indexes and Corestore lifecycle",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./hypercore": {
      "import": {
        "types": "./dist/hypercore-log.d.ts",
        "default": "./dist/hypercore-log.js"
      },
      "require": {
        "types": "./dist/cjs/hypercore-log.d.ts",
        "default": "./dist/cjs/hypercore-log.js"
      }
    },
    "./hyperbee": {
      "import": {
        "types": "./dist/hyperbee-index.d.ts",
        "default": "./dist/hyperbee-index.js"
      },
      "require": {
        "types": "./dist/cjs/hyperbee-index.d.ts",
        "default": "./dist/cjs/hyperbee-index.js"
      }
    },
    "./hyperdrive": {
      "import": {
        "types": "./dist/hyperdrive-artifacts.d.ts",
        "default": "./dist/hyperdrive-artifacts.js"
      },
      "require": {
        "types": "./dist/cjs/hyperdrive-artifacts.d.ts",
        "default": "./dist/cjs/hyperdrive-artifacts.js"
      }
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "test": "jest"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@totemsdk/core": "workspace:^",
    "@totemsdk/replication": "workspace:^",
    "autobase": "7.28.2",
    "corestore": "7.11.0",
    "@totemsdk/storage": "workspace:^"
  },
  "peerDependencies": {
    "corestore": ">=6.0.0",
    "hyperbee": ">=2.0.0",
    "hypercore": ">=10.0.0"
  },
  "peerDependenciesMeta": {
    "corestore": {
      "optional": true
    },
    "hyperbee": {
      "optional": true
    },
    "hypercore": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "hyperbee": "^2.27.3",
    "hypercore": "^11.33.5",
    "hyperdrive": "^13.3.3",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "author": "Totem SDK",
  "homepage": "https://docs.totem.ing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totem-Edge/totem-sdk.git",
    "directory": "packages/replication-holepunch"
  },
  "bugs": {
    "url": "https://github.com/Totem-Edge/totem-sdk/issues"
  },
  "keywords": [
    "totem",
    "replication",
    "hypercore",
    "hyperbee",
    "holepunch"
  ]
}
