{
  "name": "@totemsdk/omnia-lsp-provider",
  "version": "0.2.0",
  "description": "Reference Omnia Liquidity Service Provider — policy, signed quotes and host adapter",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "prepare": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "clean": "rm -rf dist",
    "test": "jest --config ../../tests/jest/omnia-lsp-provider.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@totemsdk/core": "workspace:^",
    "@totemsdk/omnia-lsp": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "author": "Totem SDK",
  "homepage": "https://docs.totem.ing",
  "bugs": {
    "url": "https://github.com/Totem-Edge/totem-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totem-Edge/totem-sdk.git",
    "directory": "packages/omnia-lsp-provider"
  },
  "keywords": [
    "totem",
    "totemsdk",
    "minima",
    "omnia",
    "lsp",
    "liquidity",
    "provider",
    "channel",
    "onboarding"
  ],
  "type": "module"
}
