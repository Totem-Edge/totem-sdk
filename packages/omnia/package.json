{
  "name": "@totemsdk/omnia",
  "version": "1.0.2",
  "description": "Omnia eltoo payment channel state machine — transport-agnostic, WOTS-safe, HTLC-ready",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./relay": {
      "import": {
        "types": "./dist/relay-client.d.ts",
        "default": "./dist/relay-client.js"
      },
      "require": {
        "types": "./dist/cjs/relay-client.d.ts",
        "default": "./dist/cjs/relay-client.js"
      }
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "build:wasm": "cd rust && wasm-pack build --target bundler --out-dir pkg && wasm-pack build --target nodejs --out-dir pkg-node",
    "prepare": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "clean": "rm -rf dist rust/pkg rust/pkg-node rust/target",
    "test": "jest",
    "test:parity": "npm run build:wasm && jest parity-fixtures omnia-parity-recovery omnia-wasm-parity"
  },
  "files": [
    "dist",
    "rust/pkg/",
    "rust/pkg-node/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@totemsdk/agent-policy": "workspace:^",
    "@totemsdk/chain-provider": "workspace:^",
    "@totemsdk/core": "workspace:^",
    "@totemsdk/kissvm": "workspace:^",
    "@totemsdk/lookup-protocol": "workspace:^",
    "@totemsdk/stream-transport": "workspace:^",
    "@totemsdk/tx-builder": "workspace:^",
    "@totemsdk/txpow": "workspace:^",
    "@totemsdk/wots-lease": "workspace:^",
    "hyperswarm": ">=4.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Totem SDK",
  "homepage": "https://docs.totem.ing",
  "bugs": {
    "url": "https://github.com/Totem-Edge/totem-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totem-Edge/totem-sdk.git",
    "directory": "packages/omnia"
  },
  "keywords": [
    "totem",
    "totemsdk",
    "minima",
    "blockchain",
    "quantum-resistant",
    "wots",
    "utxo",
    "omnia",
    "payment-channel",
    "eltoo",
    "layer2",
    "channel",
    "htlc",
    "state-machine"
  ],
  "type": "module",
  "typesVersions": {
    "*": {
      "relay": [
        "./dist/cjs/relay-client.d.ts"
      ]
    }
  }
}
