{
  "name": "@totemsdk/p2p-hub",
  "version": "0.1.0",
  "description": "Local P2P hub — one Hyperswarm instance shared by Totem apps over a loopback WebSocket bridge",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})+'\\n')\"",
    "test": "jest"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@totemsdk/core": "workspace:^",
    "@totemsdk/pubsub-transport": "workspace:^",
    "@totemsdk/stream-transport": "workspace:^",
    "ws": "^8.21.1"
  },
  "peerDependencies": {
    "hyperswarm": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "hyperswarm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Totem SDK",
  "homepage": "https://docs.totem.ing",
  "bugs": {
    "url": "https://github.com/Totem-Edge/totem-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totem-Edge/totem-sdk.git",
    "directory": "packages/p2p-hub"
  },
  "keywords": [
    "totem",
    "totemsdk",
    "minima",
    "p2p",
    "hyperswarm",
    "websocket",
    "transport",
    "hub"
  ]
}
