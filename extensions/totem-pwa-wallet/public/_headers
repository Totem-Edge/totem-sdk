/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.axia.to wss://api.axia.to https://*.axia.to; img-src 'self' data: blob:; font-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# ─────────────────────────────────────────────────────────────────────────────
# Paths below are the /web-prefixed ones because production serves this project
# at wallet.totem.ing/web (the wallet host root belongs to the portfolio). Header
# rules match the request path exactly, so unprefixed rules like `/provider.js`
# never applied — which is how a stale provider bundle could sit in a browser
# cache for 4 hours and keep opening a 404 approval URL.
# ─────────────────────────────────────────────────────────────────────────────

# Main wallet app — strict isolation (COOP/COEP + no framing)
/web/index.html
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

/web/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Approval popup pages — MUST NOT have COOP so window.opener is preserved.
# Both desktop (popup) and mobile (new tab opened by window.open) flows rely on
# window.opener?.postMessage() to return the signed result to the dApp page.
/web/approval/*
  Cross-Origin-Opener-Policy: unsafe-none
  Access-Control-Allow-Origin: *

# The dApp bridge. Must never be cached: a stale copy keeps building approval
# URLs for a deployment that no longer exists.
/web/provider.js
  Access-Control-Allow-Origin: *
  Content-Type: application/javascript
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: no-store, max-age=0

/web/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# ── Root-deployment equivalents (kept so a base-/ deploy is still correct) ───
/index.html
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/approval/*
  Cross-Origin-Opener-Policy: unsafe-none
  Access-Control-Allow-Origin: *

/provider.js
  Access-Control-Allow-Origin: *
  Content-Type: application/javascript
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: no-store, max-age=0

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
