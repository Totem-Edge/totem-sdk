{
  "name": "totem-pear-android-starter",
  "version": "0.1.0",
  "description": "Quickstart scaffold wiring @totemsdk/pear adapters into @totemsdk/edge for a mobile Pear app, including Omnia L2 payment channels",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "pear": "pear run --dev ."
  },
  "dependencies": {
    "@totemsdk/edge": "workspace:^",
    "@totemsdk/omnia": "workspace:^",
    "@totemsdk/pear": "workspace:^",
    "@totemsdk/minima-rpc": "workspace:^",
    "@noble/hashes": "^2.2.0"
  },
  "peerDependencies": {
    "hyperbee": ">=2.0.0",
    "hypercore": ">=10.0.0"
  },
  "peerDependenciesMeta": {
    "hyperbee": {
      "optional": true
    },
    "hypercore": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totem-Edge/totem-sdk.git",
    "directory": "packages/totem-pear-android-starter"
  },
  "bugs": {
    "url": "https://github.com/Totem-Edge/totem-sdk/issues"
  },
  "homepage": "https://totem.ing",
  "author": "Totem SDK",
  "keywords": [
    "totem",
    "totemsdk",
    "minima",
    "blockchain",
    "pear",
    "android",
    "mobile",
    "omnia",
    "payment-channels"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
