      "typecheck",
      "lint",
      "test",
      "pack"
    ],
    "rc": [
      "typecheck",
      "lint",
      "test",
      "pack",
      "integration"
    ],
    "v1": [
      "typecheck",
      "lint",
      "test",
      "pack",
      "integration",
      "conformance",
      "recovery",
      "consumer"
    ]
  },
