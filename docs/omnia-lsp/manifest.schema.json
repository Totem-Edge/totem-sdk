{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://totem.ing/schemas/omnia-lsp/v1/manifest.schema.json",
  "title": "Omnia LSP Provider Manifest",
  "description": "Signed provider manifest payload for Omnia LSP v1. The signature is carried by the surrounding SignedManifest envelope, not by this payload.",
  "type": "object",
  "required": [
    "version",
    "providerId",
    "identity",
    "service",
    "channel",
    "assets",
    "fees",
    "terms",
    "custody",
    "publishedAt",
    "expiresAt",
    "sequence"
  ],
  "properties": {
    "version": {
      "const": "omnia-lsp/v1"
    },
    "providerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "identity": {
      "type": "object",
      "required": ["address"],
      "properties": {
        "address": {
          "type": "string",
          "minLength": 1
        },
        "publicKey": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "proofRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "name", "version", "relayUrl"],
      "properties": {
        "type": {
          "const": "omnia-lsp"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "relayUrl": {
          "type": "string",
          "pattern": "^wss?://"
        }
      }
    },
    "channel": {
      "type": "object",
      "required": ["partyId", "publicKeyDigest", "settlementAddress"],
      "properties": {
        "partyId": {
          "type": "string",
          "minLength": 1
        },
        "publicKeyDigest": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "settlementAddress": {
          "type": "string",
          "minLength": 1
        },
        "addressIndex": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "fees": {
      "$ref": "#/$defs/fees"
    },
    "terms": {
      "$ref": "#/$defs/terms"
    },
    "custody": {
      "$ref": "#/$defs/custody"
    },
    "bond": {
      "$ref": "#/$defs/bond"
    },
    "publishedAt": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix epoch milliseconds."
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix epoch milliseconds. Clients MUST reject stale manifests."
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic per providerId + manifest version."
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "amount": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?$"
    },
    "bps": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000
    },
    "asset": {
      "type": "object",
      "required": [
        "tokenId",
        "scale",
        "inboundCapacity",
        "outboundCapacity",
        "minChannel",
        "maxChannel"
      ],
      "properties": {
        "tokenId": {
          "type": "string",
          "pattern": "^(0x00|0x[0-9a-fA-F]{64})$"
        },
        "scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 44
        },
        "inboundCapacity": {
          "$ref": "#/$defs/amount"
        },
        "outboundCapacity": {
          "$ref": "#/$defs/amount"
        },
        "minChannel": {
          "$ref": "#/$defs/amount"
        },
        "maxChannel": {
          "$ref": "#/$defs/amount"
        }
      }
    },
    "fees": {
      "type": "object",
      "properties": {
        "openBps": {
          "$ref": "#/$defs/bps"
        },
        "openFlat": {
          "$ref": "#/$defs/amount"
        },
        "leaseBps": {
          "$ref": "#/$defs/bps"
        },
        "routingBps": {
          "$ref": "#/$defs/bps"
        },
        "swapSpreadBps": {
          "$ref": "#/$defs/bps"
        }
      }
    },
    "terms": {
      "type": "object",
      "required": ["lease", "jit", "closePolicy"],
      "properties": {
        "lease": {
          "type": "boolean"
        },
        "jit": {
          "type": "boolean"
        },
        "closePolicy": {
          "enum": ["cooperative", "unilateral", "either"]
        },
        "minLockBlocks": {
          "type": "integer",
          "minimum": 0
        },
        "maxLockBlocks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "custody": {
      "type": "object",
      "required": ["mode", "canMoveFunds"],
      "properties": {
        "mode": {
          "enum": ["self", "trust-minimised", "hosted"]
        },
        "canMoveFunds": {
          "type": "boolean",
          "description": "MUST be false for a non-custodial Omnia LSP. true requires RFC-058 hosted-custody disclosure."
        },
        "disclosureHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        }
      }
    },
    "bond": {
      "type": "object",
      "required": ["providerBondId", "asset", "amount"],
      "properties": {
        "providerBondId": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "$ref": "#/$defs/amount"
        },
        "proofRef": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
