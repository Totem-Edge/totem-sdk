{
  "name": "totem-sdk",
  "version": "1.0.0",
  "private": true,
  "description": "Totem SDK monorepo \u2014 quantum-resistant decentralized computing platform for the Minima network",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totem-Edge/totem-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Totem-Edge/totem-sdk/issues"
  },
  "homepage": "https://totem.ing",
  "author": "Totem SDK",
  "license": "MIT",
  "keywords": [
    "totem",
    "totemsdk",
    "minima",
    "blockchain",
    "quantum-resistant",
    "wots",
    "kissvm",
    "utxo",
    "payment-channels",
    "edge-computing",
    "cryptography"
  ],
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "clean": "pnpm -r run clean",
    "build": "pnpm -r --workspace-concurrency=4 run build",
    "typecheck": "node scripts/verify-workspace.mjs --typecheck",
    "lint": "node scripts/verify-workspace.mjs --lint",
    "test": "node scripts/verify-workspace.mjs --test",
    "test:integration": "node scripts/verify-workspace.mjs --integration",
    "test:pack": "node scripts/verify-workspace.mjs --pack",
    "verify:mcp-pack": "node scripts/verify-mcp-pack.mjs",
    "verify:go": "node scripts/verify-go.mjs",
    "verify": "node scripts/verify-workspace.mjs --all && node scripts/verify-wallets.mjs",
    "verify:wallets": "node scripts/verify-wallets.mjs",
    "smoke-test": "node scripts/smoke-test-imports.mjs",
    "smoke:wots:prepare": "node scripts/smoke-wots-prepare.mjs",
    "smoke:wots:e2e": "node scripts/smoke-wots-e2e.mjs",
    "serve:wots:prod": "node scripts/serve-wots-prod.mjs",
    "docs": "typedoc",
    "validate:meta": "node scripts/validate-pkg-meta.mjs",
    "validate:manifest": "node scripts/verify-sdk-manifest.mjs",
    "validate:custody": "node scripts/validate-custody.mjs",
    "custody:golden": "node scripts/custody-golden.mjs",
    "custody:golden:check": "node scripts/custody-golden.mjs --check",
    "custody:exec": "node scripts/custody-exec.mjs",
    "custody:exec:vm": "node scripts/custody-exec-vm.mjs",
    "signature:parity": "node scripts/custody-signature-parity.mjs",
    "exercise:exec:vm": "node scripts/exercise-exec-vm.mjs",
    "validate:ports": "node scripts/check-state-ports.mjs",
    "validate:composite-ports": "node scripts/check-composite-ports.mjs",
    "release:family-install": "node scripts/check-family-install.mjs",
    "release:upstream": "node scripts/check-upstream-published.mjs",
    "validate:qvac-drift": "node scripts/verify-qvac-api-drift.mjs",
    "validate:node-syntax": "node scripts/check-node-syntax.mjs",
    "validate:wallet-adapter-parity": "node scripts/check-wallet-adapter-parity.mjs",
    "smoke:runtime": "node scripts/runtime-smoke.cjs",
    "smoke:runtime:native": "node scripts/runtime-smoke.cjs --native",
    "test:omnia:s4": "node scripts/omnia-s4-cross.mjs",
    "test:omnia:s5": "node scripts/omnia-s5-cross.mjs",
    "test:omnia:s9": "node scripts/omnia-s9-relay.mjs"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typedoc": "^0.28.20",
    "typescript": "5.9.3"
  }
}
