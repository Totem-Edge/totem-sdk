{
  "name": "totem-sdk",
  "version": "1.0.0",
  "private": true,
  "description": "Totem SDK monorepo — quantum-resistant decentralized computing platform for the Minima network",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totem-sdk/totem-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/totem-sdk/totem-sdk/issues"
  },
  "homepage": "https://totem.ing",
  "author": "Totem SDK",
  "license": "MIT",
  "keywords": [
    "totem",
    "totemsdk",
    "minima",
    "blockchain",
    "quantum-resistant",
    "wots",
    "kissvm",
    "utxo",
    "payment-channels",
    "edge-computing",
    "cryptography"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:txpow && npm run build:server && npm run build:root-identity",
    "build:core": "cd packages/core && npm run build",
    "build:txpow": "cd packages/txpow && npm run build",
    "build:server": "cd packages/server && npm run build",
    "build:root-identity": "cd packages/root-identity && npm run build",
    "build:extension": "cd extensions/totem-extension && npm run build",
    "test": "cd packages/core && npm test && cd ../txpow && npm test",
    "test:extension": "cd extensions/totem-extension && npm test",
    "smoke-test": "node scripts/smoke-test-imports.mjs",
    "prepack": "node scripts/smoke-test-imports.mjs",
    "smoke:wots:prepare": "node scripts/smoke-wots-prepare.mjs",
    "smoke:wots:e2e": "node scripts/smoke-wots-e2e.mjs",
    "serve:wots:prod": "node scripts/serve-wots-prod.mjs",
    "docs": "typedoc",
    "validate:meta": "node scripts/validate-pkg-meta.mjs",
    "clean": "for d in packages/*/; do (cd \"$d\" && npm run clean); done"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typedoc": "^0.28.20",
    "typescript": "^5.0.0"
  }
}
